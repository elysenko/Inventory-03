# ---- StockRoom API ----------------------------------------------------------
# Copy to backend/.env for local development. In deployed environments these are
# injected from the platform's secret store.

# Required. Provisioned by the platform.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_development"

# Required. Signs the HS256 bearer tokens. Falls back to an insecure development
# secret (with a loud warning) when unset, so a missing value never crash-loops.
JWT_SECRET="change-me-in-production"

# Optional. Token lifetime; defaults to 12h.
JWT_EXPIRES_IN="12h"

# Optional. HTTP port; defaults to 3001 (the port colossus.yaml advertises).
PORT=3001

# Optional. Comma-separated origins allowed through CORS. Only needed for the
# `ng serve` dev proxy — in production nginx puts the SPA and the API on one origin.
FRONTEND_URL="http://localhost:4200"

# Optional. Set to "false" to skip the idempotent demo seed on container start.
SEED_ON_BOOT=true

# ---- Optional service credentials -------------------------------------------
# Every key below is optional. A missing value degrades the dependent feature
# (HTTP 503 via ServiceUnconfiguredError) and is never fatal at boot. Each one
# can also be set at runtime from /admin/settings, which writes a SystemSetting
# row that resolveConfig() falls back to when the env var is absent.
MINIO_ENDPOINT=""
MINIO_ACCESS_KEY=""     # also read from MINIO_ROOT_USER
MINIO_SECRET_KEY=""     # also read from MINIO_ROOT_PASSWORD
