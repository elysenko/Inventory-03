# Dependencies — regenerated by `npm ci` during the deploy build; never committed.
node_modules/

# Build output — regenerated by `npm run build` during the deploy build.
dist/
out-tsc/
/tmp/

# Angular build cache
.angular/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS noise
.DS_Store
*.swp

# Mockup preview build output — regenerated by the UI stage, served as a static preview.
/mockup/

# TypeScript incremental build cache
*.tsbuildinfo
